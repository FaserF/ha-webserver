{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":prHourlyLimitNone",
    ":dependencyDashboard"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Avoid pinning Home Assistant manifest.json requirements (Hassfest compliance)",
      "matchFileNames": [
        "custom_components/*/manifest.json"
      ],
      "rangeStrategy": "widen"
    },
    {
      "description": "Do not manage Home Assistant built-in aiohttp in manifest.json",
      "matchFileNames": [
        "custom_components/*/manifest.json"
      ],
      "matchPackageNames": [
        "aiohttp"
      ],
      "enabled": false
    }
  ],
  "github-actions": {
    "enabled": true
  }
}
